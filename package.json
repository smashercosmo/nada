{
  "name": "nada",
  "version": "0.0.1",
  "private": false,
  "description": "Simple CLI tool yjay makes it easier to install dependencies, especcially useful for monorepos.",
  "keywords": [
    "dependency management",
    "monorepos"
  ],
  "bugs": "https://github.com/smashercosmo/nada/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smashercosmo/nada.git"
  },
  "license": "MIT",
  "author": "Vladislav Shkodin <smashercosnmo@gmail.com>",
  "contributors": [
    {
      "name": "Vladislav Shkodin",
      "email": "smashercosnmo@gmail.com"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#lib/*.js": "./src/lib/*.ts",
    "#tests/*.js": "./src/tests/*.ts",
    "#src/*.js": "./src/*.ts",
    "#root/*": "./*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "nada": "./src/index.ts"
  },
  "man": [
    "./docs/deps-install.1"
  ],
  "directories": {
    "lib": "src/lib",
    "test": "src/tests"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean:all": "pnpm clean:dist && pnpm clean:modules && pnpm clean:lock",
    "clean:dist": "rm -rf dist",
    "clean:lock": "rm -rf pnpm-lock.yaml",
    "clean:modules": "pnpm clean",
    "format": "oxfmt",
    "lint:compat": "es-check",
    "lint:es": "eslint",
    "lint:ox": "oxlint --type-aware",
    "lint": "pnpm lint:es && pnpm lint:ox && lint:compat",
    "nada": "node src/index.ts",
    "test": "vitest run",
    "test:pnpm": "pnpm run \"/^test:pnpm:(11|12|latest)$/\"",
    "test:pnpm:11": "pnpm with 11.0.0 test",
    "test:pnpm:12": "pnpm with 12.0.0 test",
    "test:pnpm:latest": "pnpm with latest test",
    "typecheck": "pnpm --noEmit",
    "update:deps": "pnpm up --latest --interactive"
  },
  "dependencies": {
    "@clack/prompts": "catalog:deps",
    "@pnpm/cli.meta": "catalog:pnpm",
    "@pnpm/cli.utils": "catalog:pnpm",
    "@pnpm/deps.inspection.commands": "catalog:pnpm",
    "@pnpm/deps.inspection.list": "catalog:pnpm",
    "yaml": "catalog:deps"
  },
  "devDependencies": {
    "@eslint/js": "catalog:lint",
    "@eslint/json": "catalog:lint",
    "@pnpm/catalogs.types": "catalog:pnpm",
    "@pnpm/config.reader": "catalog:pnpm",
    "@pnpm/resolving.registry.types": "catalog:pnpm",
    "@pnpm/types": "catalog:types",
    "@types/node": "catalog:types",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "catalog:test",
    "actions-up": "catalog:dev",
    "cli-testing-library": "catalog:test",
    "es-check": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-plugin-n": "catalog:lint",
    "eslint-plugin-package-json": "catalog:lint",
    "globals": "catalog:lint",
    "jiti": "catalog:dev",
    "node-pty": "catalog:test",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "ts-extras": "catalog:types",
    "tsdown": "catalog:dev",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "catalog:lint",
    "vitest": "catalog:test"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "v12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "v26.10.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "bin": {
      "nada": "./dist/index.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
