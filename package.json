{
  "name": "nada",
  "version": "0.0.0",
  "private": false,
  "description": "Simple CLI tool yjay makes it easier to install dependencies, especcially useful for monorepos.",
  "keywords": [
    "dependency management",
    "monorepos"
  ],
  "bugs": "https://github.com/smashercosmo/nada/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smashercosmo/nada.git"
  },
  "license": "MIT",
  "author": "Vladislav Shkodin <smashercosnmo@gmail.com>",
  "contributors": [
    {
      "name": "Vladislav Shkodin",
      "email": "smashercosnmo@gmail.com"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#lib/*.js": "./src/lib/*.ts",
    "#tests/*.js": "./src/tests/*.ts",
    "#root/*": "./*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "nada": "src/lib/index.ts"
  },
  "man": [
    "./docs/deps-install.1"
  ],
  "directories": {
    "lib": "src/lib",
    "test": "src/tests"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean:all": "pnpm clean:dist && pnpm clean:modules && pnpm clean:lock",
    "clean:dist": "rm -rf dist",
    "clean:lock": "rm -rf pnpm-lock.yaml",
    "clean:modules": "pnpm clean",
    "format": "oxfmt",
    "lint": "oxlint --type-aware && eslint",
    "lint:fix": "oxlint --type-aware --fix && eslint --fix",
    "nada": "node src/lib/index.ts",
    "test": "vitest run",
    "typecheck": "pnpm --noEmit",
    "update:deps": "pnpm up --latest --interactive"
  },
  "dependencies": {
    "@clack/prompts": "catalog:deps",
    "@pnpm/cli.meta": "catalog:pnpm",
    "@pnpm/cli.utils": "catalog:pnpm",
    "configs": "catalog:",
    "my": "catalog:",
    "myconfig": "catalog:",
    "yaml": "catalog:deps"
  },
  "devDependencies": {
    "@eslint/json": "catalog:lint",
    "@pnpm/types": "catalog:types",
    "@stylistic/eslint-plugin": "catalog:lint",
    "@types/node": "catalog:types",
    "@types/semver": "catalog:pnpm",
    "@vitest/coverage-v8": "catalog:test",
    "actions-up": "catalog:dev",
    "cli-testing-library": "catalog:test",
    "eslint": "catalog:lint",
    "eslint-plugin-package-json": "catalog:lint",
    "jiti": "catalog:dev",
    "node-pty": "catalog:test",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "semver": "catalog:pnpm",
    "ts-extras": "catalog:types",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
      "packageManager": {
        "name": "pnpm",
        "version": "v12.6.0"
      },
      "runtime": {
        "name": "node",
        "version": "v26.10.0"
      }
    },
  "publishConfig": {
    "bin": {
      "nada": "./dist/index.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
